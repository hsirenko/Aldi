# Required for the Telegram bot
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Optional: OpenAI chat model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o
# Optional: OpenAI-compatible base URL (for Groq, etc.)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant
# Optional deterministic local mode:
# - off: use online provider only (default)
# - auto: use online provider, fallback locally on provider failure
# - on: use local deterministic mode only (no OpenAI/Groq needed)
# OFFLINE_FALLBACK_MODE=off

# Optional: full path to tesseract if not on PATH (macOS Homebrew example)
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
